# Скопируй в .env и поменяй пароли. Сам .env в git не коммитится (.gitignore).
POSTGRES_DB=excel_automation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Сид админа при ПЕРВОМ старте (пока таблица users пуста).
# Вне докера подхватывается сразу; в compose-файл пока не прокинуто —
# для докера действуют дефолты из application.yaml (admin/admin).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin